# HASH256 Miner Configuration
# Copy this to .env and fill in your values

# Your wallet address (required)
MINER_WALLET=0xYOUR_WALLET_ADDRESS_HERE

# Private key for auto-submitting mine() transactions (optional)
# WARNING: Never share this! Never commit this file!
MINER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Ethereum RPC endpoint (required)
# Free options: https://eth.llamarpc.com, https://rpc.ankr.com/eth
# Paid (faster): Alchemy, Infura, QuickNode
MINER_RPC_URL=https://eth.llamarpc.com

# HASH256 contract address (update with actual address from hash256.org)
HASH256_CONTRACT=0x0000000000000000000000000000000000000000
